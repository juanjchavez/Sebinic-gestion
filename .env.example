# Copiar este archivo a .env y completar con valores reales. .env nunca se commitea.
SECRET_KEY=cambia-esta-clave-por-una-generada-localmente
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=seminario_dev
DB_USER=seminario_app
DB_PASSWORD=cambia-esta-contraseña
DB_HOST=localhost
DB_PORT=5432
# Adjuntos: directorio privado FUERA del repo y de la raíz web (obligatoria). Usar / en Windows.
ADJUNTOS_ROOT=C:/seminario-datos/adjuntos
ADJUNTO_TAMANO_MAX_MB=10
# URL pública del sitio, para los enlaces de los correos.
URL_BASE_SITIO=http://localhost:8000
# Correo saliente. En local se imprime en consola; en el VPS usar el backend SMTP. Valores provisionales.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=webmaster@localhost
# Acceso de usuarios (provisionales hasta que el seminario elija).
ENLACE_ACCESO_VIGENCIA_DIAS=3
ACCESO_REINTENTOS_MAX=3
